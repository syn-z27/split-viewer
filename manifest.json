{
  "manifest_version": 3,
  "name": "Split Viewer",
  "version": "0.1.0",
  "description": "Ctrl+Shift+Click a link to open it in split view.",
  "minimum_chrome_version": "155",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
